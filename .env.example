# FORGE private Construction CRM
# Use your dedicated Neon 'forge-construction-crm' database, NOT another application's database.
FORGE_DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST/forgecrm?sslmode=require"
# Generate with: openssl rand -hex 32
# Supply only for initial admin setup. Remove after first administrator is created.
FORGE_BOOTSTRAP_TOKEN=""
# Optional private random value used to hash request fingerprints for login throttling.
FORGE_RATE_LIMIT_SALT=""
